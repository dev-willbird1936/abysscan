# Template for /etc/caddy/Caddyfile. setup.sh substitutes the three double-underscore tokens below: the site address becomes the
# --host value; the global-option and tls lines stay empty (automatic certificates, HTTP redirects on port 80) except in dry
# runs (`--no-http-redirect`, `--tls-internal`).
# Caddy is the only public listener (SPEC 7.1); the controller listens on 127.0.0.1:4173.
{
	# HTTP/3 would need UDP 443, which the firewall keeps closed (firewall.md): serve HTTP/1.1 and HTTP/2 only.
	servers {
		protocols h1 h2
	}
	__GLOBAL_OPTION__
}

__PUBLIC_HOST__ {
	__TLS__

	# Browser login gate. The bcrypt hash lives in /etc/caddy/access.caddy on the VM, not in this repository. Caddy refuses to
	# start unless that file exists and contains basic_auth (deploy/vultr-vm/README.md).
	import /etc/caddy/access.caddy

	# 100 MB upload cap in the controller plus multipart overhead (SPEC 7.3).
	request_body {
		max_size 110MB
	}

	# Compress the pages, scripts and data (the renderer bundle is 1.4 MB raw). Not /api/*: job progress is a server-sent
	# event stream, and a compressor would hold its events back.
	@compressible not path /api/*
	encode @compressible zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Plain text, not the controller's JSON 404. Allows the public demo to be indexed.
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond "User-agent: *\nAllow: /\nSitemap: https://demo.abysscan.com/sitemap.xml\n" 200
	}

	# Static files in /var/www/abysscan (setup.sh copies deploy/vultr-vm/www/*).
	handle /og.png {
		root * /var/www/abysscan
		header Content-Type image/png
		header Cache-Control "public, max-age=86400"
		file_server
	}
	handle /favicon.ico {
		root * /var/www/abysscan
		header Content-Type image/x-icon
		header Cache-Control "public, max-age=86400"
		file_server
	}
	handle /favicon.svg {
		root * /var/www/abysscan
		header Content-Type "image/svg+xml"
		header Cache-Control "public, max-age=86400"
		file_server
	}
	handle /apple-touch-icon.png {
		root * /var/www/abysscan
		header Content-Type image/png
		header Cache-Control "public, max-age=86400"
		file_server
	}
	handle /sitemap.xml {
		root * /var/www/abysscan
		header Content-Type "application/xml; charset=utf-8"
		header Cache-Control "public, max-age=3600"
		file_server
	}
	handle /.well-known/security.txt {
		rewrite * /security.txt
		root * /var/www/abysscan
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "public, max-age=86400"
		file_server
	}
	handle /security.txt {
		redir * /.well-known/security.txt permanent
	}

	# JSON 404s stay on /api/*. Other missing pages become a Caddy error so handle_errors can serve HTML and keep status 404.
	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:4173 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy 127.0.0.1:4173 {
			flush_interval -1
			@notFound status 404
			handle_response @notFound {
				error 404
			}
		}
	}
	handle_errors {
		@missing expression `{err.status_code} == 404`
		handle @missing {
			root * /var/www/abysscan
			rewrite * /404.html
			header Content-Type "text/html; charset=utf-8"
			header Strict-Transport-Security "max-age=31536000"
			header -Server
			file_server
		}
	}
}
