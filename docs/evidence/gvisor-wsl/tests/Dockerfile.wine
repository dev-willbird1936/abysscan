FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN dpkg --add-architecture i386 && apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends wine wine64 wine32:i386 libwine libwine:i386 fonts-wine xvfb xauth procps ca-certificates >/dev/null
RUN useradd -u 10001 -m -d /home/dana -s /bin/sh dana
